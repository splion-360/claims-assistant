CRUSOE_API_KEY=replace-me
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1

DREX_API_KEY=replace-me

# Optional voice
DEEPGRAM_API_KEY=

# Optional book prices. Without a key the Google Books quota refuses most requests
# and books are reported unpriced in the review queue rather than given a made-up figure.
GOOGLE_BOOKS_API_KEY=

# Model choices and generation settings are configured in config.yml.
