CRUSOE_API_KEY=replace-me
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1

DREX_API_KEY=replace-me

# Optional voice
DEEPGRAM_API_KEY=

# Optional catalogue and ebook prices. Without a key the Google Books quota refuses most
# requests; Open Library still answers the catalogue and other price sources still run.
GOOGLE_BOOKS_API_KEY=

# Store listings (Amazon new prices, AbeBooks used prices, object price ranges), read as
# a visitor in the policyholder's country through the Nimble web API. Without it books
# fall back to Google Books, and used values and object prices are left empty with the reason.
NIMBLE_API_KEY=

# Model choices and generation settings are configured in config.yml.

# Serve the sweep through a tunnel as well as localhost, for a phone on a network
# that blocks device-to-device traffic. Set it to the tunnel's host only, with no
# scheme or path, and leave it empty to keep the sweep local-only:
#   ngrok http 4177      ->  PUBLIC_HOST=<name>.ngrok-free.dev
# Anyone holding the tunnel URL can reach the sweep while it is set.
PUBLIC_HOST=
